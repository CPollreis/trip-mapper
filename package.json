{
  "name": "trip-mapper",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:public": "node scripts/guard-public.mjs && astro build",
    "preview": "astro preview",
    "routes": "node scripts/routes.mjs",
    "exports": "node scripts/exports.mjs",
    "check": "node scripts/check.mjs",
    "new-trip": "node lib/seed.mjs",
    "trips": "node -e \"import('./src/lib/trips.mjs').then(m=>console.log(m.listTrips(new URL('.',import.meta.url)).join('\\n')||'no trips yet'))\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.5",
    "maplibre-gl": "^5.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
